---
import Base from '../layouts/Base.astro';
import DatedList from '../components/DatedList.astro';
import Subscribe from '../components/Subscribe.astro';
import { getPosts, getProjects } from '../lib/content';

const all = await getPosts();
const latest = all.slice(0, 10);
const favourites = all.filter((p) => p.data.favourite);
const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const resources = projects.filter((p) => !p.data.featured);
const words = all.reduce((n, p) => n + (p.body ?? '').split(/\s+/).filter(Boolean).length, 0);

const roles = ['a painter', 'a data scientist', 'a stoic', 'a research engineer', 'an ML engineer'];
const href = (p: (typeof projects)[number]) => p.data.external || p.data.github || '/prototyping/';
const blurb = (body = '') => (body.trim().split('\n\n')[0].match(/^.*?[.!?](\s|$)/)?.[0] ?? body).trim();
---
<Base>
  <section class="hero">
    <h1>Hi, I'm Indranil, <span class="rotator" data-words={JSON.stringify(roles)}>{roles[0]}</span>.</h1>
    <p>
      I build agents and ML on graphs and language models. I'm an ML engineer at a major US telecom,
      where dynamic agents handle multi-modal inbound/outbound campaigns to fault resolution end to end.
      At <a href="https://cs.utdallas.edu/">UT Dallas</a> I research adversarial red-teaming agents for
      network protocols. Before that, graph ML and recommenders at <a href="https://www.g2.com/">G2</a>
      and transformers in production at <a href="https://byjus.com/">Byju's</a>. Outside of work, I also...
    </p>
  </section>

  <ul class="bullets">
    <li>Write about <a href="/writing/">agents, graph ML, and what I'm learning</a>.</li>
    <li>Prototype <a href="/prototyping/">local-first tools</a>: a personal inference engine, protocol red-teaming agents, and a notes-to-knowledge-base workflow in Obsidian.</li>
    <li>Contribute to <a href="https://openclimatefix.org/">OpenClimateFix</a>'s open-source graph weather models.</li>
    <li>Paint, and read the Stoics when things get loud.</li>
  </ul>

  <Subscribe />

  {latest.length > 0 && (
    <>
      <h2 class="sec">Latest</h2>
      <DatedList posts={latest} />
    </>
  )}

  {favourites.length > 0 && (
    <>
      <h2 class="sec">My Favourites</h2>
      <DatedList posts={favourites} />
    </>
  )}

  <p class="stats">
    {all.length} posts, {projects.length} prototypes, {words.toLocaleString('en-US')} words, and countless hours.
  </p>

  <h2 class="sec">Selected Prototypes</h2>
  <ul class="bullets">
    {featured.map((p) => <li><a href={href(p)}>{p.data.title}</a>: {blurb(p.body)}</li>)}
  </ul>

  {resources.length > 0 && (
    <>
      <h2 class="sec">Resources</h2>
      <ul class="bullets">
        {resources.map((p) => <li><a href={href(p)}>{p.data.title}</a>: {blurb(p.body)}</li>)}
      </ul>
    </>
  )}
</Base>

<script>
  const el = document.querySelector<HTMLElement>('.rotator');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words: string[] = JSON.parse(el.dataset.words ?? '[]');
    let i = 0;
    setInterval(() => {
      el.classList.add('out');
      setTimeout(() => {
        i = (i + 1) % words.length;
        el.textContent = words[i];
        el.classList.remove('out');
      }, 300);
    }, 2200);
  }
</script>
