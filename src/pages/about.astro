---
import { getCollection } from 'astro:content';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../config';

const jobs = (await getCollection('jobs')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const rendered = await Promise.all(jobs.map(async (j) => ({ job: j, Content: (await render(j)).Content })));
const skills = [
  'Graph Neural Networks', 'Natural Language Processing', 'PyTorch', 'LangChain & LangGraph',
  'Azure and AWS', 'Terraform and CI/CD', 'MLflow and Kubeflow', 'llama.cpp & local LLMs',
];
---
<Base title="About">
  <h1>About</h1>
  <p>
    My first taste of machine learning was open-source work at <a href="https://www.iitb.ac.in/">IIT Bombay</a>
    in 2018. After that I went into industry: <a href="https://stylumia.ai/">Stylumia</a> for multimodal search,
    <a href="https://byjus.com/">Byju's</a> for transformers in production, and <a href="https://g2.com/">G2</a>
    for two years of graph neural networks over user-product data.
  </p>
  <p>
    I finished my Master's in Computer Science at <a href="https://cs.utdallas.edu/">UT Dallas</a> in December 2025.
    Alongside it I interned at ISN on multi-agent systems and a multimodal risk advisor, and I still do research at UT Dallas on
    adversarial red-teaming agents for network protocols.
  </p>
  <p>
    Today I'm a machine learning engineer at a major US telecom, building agents that resolve network faults end to end.
    Before that, and for a few months alongside it, I was a part-time founding engineer on a VR learning platform.
  </p>
  <p>
    On the side I contribute to <a href="https://openclimatefix.org/">OpenClimateFix</a>, an open-source group
    forecasting solar power, and I run my own GPU server at home for local models.
  </p>
  <p>Recently working with: {skills.join(' · ')}.</p>

  <h2>Experience</h2>
  {rendered.map(({ job, Content }) => (
    <div class="job">
      <h3>{job.data.title} · {job.data.url ? <a href={job.data.url}>{job.data.company}</a> : job.data.company}</h3>
      <div class="meta">{[job.data.range, job.data.location].filter(Boolean).join(' · ')}</div>
      <div class="prose"><Content /></div>
    </div>
  ))}

  <h2>Contact</h2>
  <p>
    Looking for a data scientist, want to argue about graphs, or found something broken on this site?
    <a href={`mailto:${site.email}`}>Email me</a>; I actually reply.
  </p>
</Base>
