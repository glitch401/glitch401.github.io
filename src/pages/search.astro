---
import Base from '../layouts/Base.astro';
---
<Base title="Search" description="Search all posts.">
  <h1>Search</h1>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <div id="search"></div>
  <p class="muted" id="dev-note" hidden>Search index is built by <code>npm run build</code>; it is not available in dev.</p>
  <script is:inline src="/pagefind/pagefind-ui.js" onerror="document.getElementById('dev-note').hidden=false"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', function () {
      if (window.PagefindUI) new PagefindUI({ element: '#search', showSubResults: true });
    });
  </script>
</Base>
